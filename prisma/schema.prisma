generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  properties Property[]
}

enum Role {
  ADMIN
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String
  note      String?
  price     Int?
  layout    String?
  size      Int?
  photos    String[] @default([])
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  devices   Device[]
  inquiries Inquiry[]
  bookings  Booking[]
}

model Device {
  id          String    @id @default(cuid())
  pairingCode String    @unique
  room        String    @default("Hlavní místnost")
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
}

model Inquiry {
  id           String   @id @default(cuid())
  budget       String?
  moveInDate   String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  createdAt    DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
}

model Booking {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  preferredAt DateTime
  message     String?
  createdAt   DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
}
