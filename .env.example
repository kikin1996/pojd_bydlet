# Postgres connection string (e.g. from InsForge, Neon, Supabase...)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Initial admin user, used by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# LiveKit (get free dev credentials at https://cloud.livekit.io)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://your-project.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
